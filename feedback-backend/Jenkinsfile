pipeline {
    agent any
    
    environment {
        DOCKER_HUB_REPO = 'kavyabarla/feedback-backend'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_CREDENTIALS_ID = 'dockerhub-credentials'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out code from GitHub...'
                git branch: 'main', 
                    url: 'https://github.com/Kavyabarla18/Feedback-devops.git'
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                script {
                    dir('feedback-backend') {  // THIS IS THE KEY FIX
                        dockerImage = docker.build("${DOCKER_HUB_REPO}:${DOCKER_IMAGE_TAG}")
                        docker.build("${DOCKER_HUB_REPO}:latest")
                    }
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                script {
                    docker.image("${DOCKER_HUB_REPO}:${DOCKER_IMAGE_TAG}").inside {
                        sh 'echo "Tests placeholder - add pytest later"'
                    }
                }
            }
        }
        
/*
stage('Push to Docker Hub') {
    steps {
        echo 'Pushing Docker image to Docker Hub...'
        script {
            docker.withRegistry('https://registry.hub.docker.com', DOCKER_CREDENTIALS_ID) {
                dockerImage.push("${DOCKER_IMAGE_TAG}")
                dockerImage.push("latest")
            }
        }
    }
}
*/

        
        stage('Deploy') {
    steps {
        echo 'Deploying application...'
        script {
            sh '''
                # Stop and remove old container if exists
                docker stop feedback-backend || true
                docker rm feedback-backend || true
                
                # Run new container
                docker run -d \
                  --name feedback-backend \
                  -p 5000:5000 \
                  kavyabarla/feedback-backend:${BUILD_NUMBER}
                
                # Wait for container to start
                sleep 5
                
                # Verify deployment
                docker ps | grep feedback-backend
                echo "Application deployed successfully!"
                echo "Access at: http://localhost:5000"
            '''
        }
    }
}

    }
    
    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs for details.'
        }
        always {
            echo 'Cleaning up...'
            sh 'docker system prune -f'
        }
    }
}
